# Application
DEBUG=false
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aet_request

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=aet-request
KEYCLOAK_ADMIN_ROLE=admin

# Ticket System ("jira", "redmine", "noop", or "debug")
TICKET_SYSTEM=jira
# Jira custom field ID for secondary reporter (Jira only)
SECONDARY_REPORTER_FIELD=customfield_12200
# Username of the service account creating tickets
SERVICE_ACCOUNT_NAME=

# Jira
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT=

# Redmine
REDMINE_URL=
REDMINE_API_KEY=
# Project identifier (slug) in Redmine, e.g. "request-test"
REDMINE_PROJECT=
# Group ID to auto-add new users to (0 = disabled). GET /groups.json to list.
REDMINE_GROUP_ID=0
# Tracker ID for created issues (e.g. 1=Bug, 2=Feature, 3=Task). GET /trackers.json to list.
REDMINE_TRACKER_ID=0
# Redmine login of the service account used for API calls
REDMINE_USERNAME=

# GitLab
GITLAB_URL=
GITLAB_TOKEN=

# OpenTelemetry (Prometheus /metrics always active; OTLP export activates when endpoint is set)
OTEL_SERVICE_NAME=aet-request-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_ENVIRONMENT=development

# Sentry (auto-enabled when SENTRY_DSN is set)
SENTRY_DSN=
