# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=master
VITE_KEYCLOAK_CLIENT_ID=request-client
VITE_ADMIN_ROLE=admin

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# OpenTelemetry (auto-enabled when VITE_OTEL_COLLECTOR_URL is set)
VITE_OTEL_COLLECTOR_URL=
VITE_OTEL_SERVICE_NAME=aet-request-client
VITE_OTEL_ENVIRONMENT=development

# Sentry (auto-enabled when VITE_SENTRY_DSN is set)
VITE_SENTRY_DSN=
